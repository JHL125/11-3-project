# 이 파일을 복사해 .env.local 로 저장한 뒤 값을 채운다. 이 예시 파일에는 실제 값을 넣지 않는다
# Vercel 에는 같은 이름으로 Project Settings → Environment Variables 에 넣는다

# Supabase → Project Settings → Data API → Project URL
VITE_SUPABASE_URL=
# Supabase → API Keys → anon(publishable) 키. 브라우저에서 읽기용
VITE_SUPABASE_ANON_KEY=

# 아래는 서버(/api 함수) 전용. VITE_ 를 붙이지 않는다 (붙이면 브라우저에 노출됨)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
# 비워 두면 gemini-3.5-flash-lite
GEMINI_MODEL=
