# 이 파일을 복사해 .env 로 저장한 뒤 값을 채운다. 이 예시 파일에는 실제 값을 넣지 않는다

# Supabase → Data API → Project URL / API Keys → service_role(secret) 키
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 공공데이터포털 → 소상공인시장진흥공단 상가(상권)정보 일반 인증키 (Encoding · Decoding 어느 쪽이든 됨)
PUBLIC_DATA_KEY=

# 업종 키워드("국밥" 등) 걸러내기에 쓴다
GEMINI_API_KEY=
GEMINI_MODEL=

# aside CLI 실행 파일. PATH 에 있으면 aside, 아니면 절대 경로 (Aside 설정 → Developer 에서 확인)
ASIDE_BIN=aside
# Aside 한 건 처리 제한 시간(초)
ASIDE_TIMEOUT_SEC=600
